# Copy to .env and fill in. Never commit .env.

# --- Gemini (Google AI Studio, native generateContent REST API) ---
GEMINI_API_KEY=
# Exact model id from Google AI Studio, or a comma-separated list tried in order when a
# model fails (rate limit, overload, …). Put the model with the biggest free quota first, e.g.
# gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# none | minimal | low | medium | high  (sent as thinkingBudget; blank omits it).
# Use "none" to turn thinking off: with "low", Gemini 2.5 Flash spends most of the
# token cap on thinking and truncates output.
GEMINI_REASONING_EFFORT=low

# --- OpenRouter (OpenAI-compatible endpoint) ---
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. a ":free" model
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as reasoning.effort (none | minimal | low | medium | high); blank omits it and
# uses the model's default. "none" turns reasoning off (faster, no hidden tokens).
OPENROUTER_REASONING_EFFORT=none

# --- Local CPU model ---
# Must fit in ~2 GB fp32; alternative: HuggingFaceTB/SmolLM2-360M-Instruct
LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_NUM_THREADS=2
LOCAL_MAX_TIME_S=90

# --- Server ---
API_TIMEOUT_S=20
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
