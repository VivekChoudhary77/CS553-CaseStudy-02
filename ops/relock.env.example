# relock.sh configuration template.
#
#   cp relock.env.example ~/.cs553/relock.env
#   chmod 600 ~/.cs553/relock.env
#
# NEVER commit the real relock.env: it may hold the Discord webhook URL, and it points at
# private keys. Only this .example file belongs in git.

# VM connection (the host forwards PORT to the VM's port 22)
HOST=paffenroth-23.dyn.wpi.edu
PORT=22025
VM_USER=student-admin

# Required: our watchdog private key (ed25519, NO passphrase — cron can't type one)
MY_KEY=$HOME/.cs553/watchdog_key
# Required: the class-wide shared key, used only to get back in after a wipe
SHARED_KEY=$HOME/.cs553/student-admin_key
# Required: the public keys that must be authorized after every relock
# (laptop key + watchdog key, one per line)
AUTH_KEYS=$HOME/.cs553/authorized_keys

# Prevents overlapping cron runs
LOCK_FILE=$HOME/.cs553/relock.lock

# Optional: Discord webhook for "wipe detected" / "relock complete" / "verification failed"
DISCORD_WEBHOOK_URL=

# DOWN (neither key works) is silent while the VM rebuilds. If it lasts longer than this
# many minutes, send ONE alert (e.g. the rebuild changed the key or port), and one more
# when the VM is reachable again. The state file tracks when DOWN started.
DOWN_ALERT_AFTER_MIN=30
DOWN_STATE_FILE=$HOME/.cs553/relock.down

# Optional: command run after a successful relock (later: redeploy the app), e.g.
# POST_RELOCK_HOOK="$HOME/.cs553/deploy.sh"
POST_RELOCK_HOOK=
